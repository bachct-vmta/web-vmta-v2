datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  email_verified_at DateTime?
  password          String
  remember_token    String?
  created_at        DateTime?
  updated_at        DateTime?
}

model Setting {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  value      String?
  type       String    @default("string")
  group      String    @default("general")
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
}

model Post {
  id                  Int       @id @default(autoincrement())
  slug                String    @unique
  slug_vi             String?
  slug_en             String?
  category            String?   @default("Sự kiện VMTA")
  title_vi            String
  title_en            String?
  summary_vi          String?
  summary_en          String?
  content_vi          String?
  content_en          String?
  image_url           String?
  author              String?   @default("Ban Biên Tập VMTA")
  status              String?   @default("published")
  is_published        Boolean   @default(true)
  published_at        String?
  meta_title_vi       String?
  meta_title_en       String?
  meta_description_vi String?
  meta_description_en String?
  meta_keywords_vi    String?
  meta_keywords_en    String?
  created_at          DateTime? @default(now())
  updated_at          DateTime? @updatedAt
}

model MedicalCategory {
  id           Int       @id @default(autoincrement())
  type         String    @default("medical")
  category_key String    @unique
  title_vi     String
  title_en     String?
  icon         String?
  created_at   DateTime? @default(now())
  updated_at   DateTime? @updatedAt
}

model MedicalPackage {
  id            Int       @id @default(autoincrement())
  category_key  String
  title_vi      String
  title_en      String?
  subtitle_vi   String?
  subtitle_en   String?
  duration_vi   String?
  duration_en   String?
  price_vi      String?
  price_en      String?
  facility_name String?
  image_url     String?
  itinerary_vi  String?
  itinerary_en  String?
  is_active     Boolean   @default(true)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
}

model AllianceMember {
  id             Int       @id @default(autoincrement())
  group_id       Int       @default(1)
  name_vi        String
  name_en        String?
  badge          String?
  logo_url       String?
  address        String?
  phone          String?
  email          String?
  website        String?
  description_vi String?
  description_en String?
  is_active      Boolean   @default(true)
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt
}

model ChatbotScript {
  id          Int       @id @default(autoincrement())
  category    String    @default("Quy trình")
  question_vi String
  question_en String?
  answer_vi   String
  answer_en   String?
  order       Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt
}

model CmsSection {
  id           Int                     @id @default(autoincrement())
  page_slug    String
  section_key  String
  is_active    Boolean                 @default(true)
  order        Int                     @default(0)
  created_at   DateTime?               @default(now())
  updated_at   DateTime?               @updatedAt
  translations CmsSectionTranslation[]

  @@unique([page_slug, section_key])
}

model CmsSectionTranslation {
  id         Int        @id @default(autoincrement())
  section_id Int
  locale     String
  title      String?
  subtitle   String?
  body       String?
  extra_json String?
  section    CmsSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, locale])
}

model Inquiry {
  id         Int       @id @default(autoincrement())
  name       String
  phone      String
  email      String?
  service    String?
  message    String?
  status     String    @default("pending")
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
}

model DentalService {
  id           Int                        @id @default(autoincrement())
  slug         String                     @unique
  image        String?
  price        String?
  is_active    Boolean                    @default(true)
  order        Int                        @default(0)
  created_at   DateTime?                  @default(now())
  updated_at   DateTime?                  @updatedAt
  translations DentalServiceTranslation[]
}

model DentalServiceTranslation {
  id                Int           @id @default(autoincrement())
  dental_service_id Int
  locale            String
  name              String
  description       String?
  content           String?
  dental_service    DentalService @relation(fields: [dental_service_id], references: [id], onDelete: Cascade)

  @@unique([dental_service_id, locale])
}

model NewsletterSubscriber {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
}
